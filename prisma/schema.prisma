generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum ProductStatus {
  NOT_ANALYZED
  IN_VALIDATION
  PROMISING
  WAITING
  DISCARDED
}

enum Marketplace {
  MERCADO_LIVRE
  SHOPEE
  AMAZON
  MAGALU
  SHEIN
  OTHER
}

enum CommercialTransactionStatus {
  DRAFT
  QUOTE_RECEIVED
  UNDER_ANALYSIS
  APPROVED
  ORDER_EFFECTIVE
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum SupplierDocumentType {
  QUOTE
  PURCHASE_ORDER
  INVOICE
  OTHER
}

enum QuoteListStatus {
  DRAFT
  SENT
  ARCHIVED
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  document    String?
  contactName String?
  email       String?
  phone       String?
  website     String?
  notes       String?
  imagePath   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  catalogs         Catalog[]
  products         Product[]
  transactions     CommercialTransaction[]
  documents        SupplierDocument[]
  quoteLists       QuoteList[]
  purchases        Purchase[]
  receivedInvoices ReceivedInvoice[]

  @@index([name])
  @@index([document])
}

model Catalog {
  id           String   @id @default(uuid())
  supplierId   String
  title        String
  fileName     String
  originalName String
  filePath     String
  fileUrl      String?
  fileSize     Int?
  mimeType     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([supplierId])
}

model Product {
  id            String        @id @default(uuid())
  supplierId    String
  catalogId     String?
  name          String
  referenceCode String?
  brand         String?
  model         String?
  ean           String?
  cost          Decimal?      @db.Decimal(12, 2)
  description   String?
  sourcePage    Int?
  status        ProductStatus @default(NOT_ANALYZED)
  justification String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  supplier         Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  catalog          Catalog?                    @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  statusHistory    ProductStatusHistory[]
  researches       MarketplaceResearch[]
  quoteListItems   QuoteListItem[]
  purchaseItems    PurchaseItem[]
  transactionItems CommercialTransactionItem[]

  @@index([supplierId])
  @@index([catalogId])
  @@index([status])
  @@index([ean])
  @@index([referenceCode])
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  fileName     String
  originalName String
  filePath     String
  fileUrl      String
  mimeType     String
  fileSize     Int
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductStatusHistory {
  id            String         @id @default(uuid())
  productId     String
  oldStatus     ProductStatus?
  newStatus     ProductStatus
  justification String?
  createdAt     DateTime       @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model MarketplaceResearch {
  id              String      @id @default(uuid())
  productId       String
  marketplace     Marketplace
  searchedTerm    String
  estimatedDemand Int?
  competition     Int?
  salePrice       Decimal?    @db.Decimal(12, 2)
  marketplaceFee  Decimal?    @db.Decimal(12, 2)
  shippingCost    Decimal?    @db.Decimal(12, 2)
  taxCost         Decimal?    @db.Decimal(12, 2)
  otherCosts      Decimal?    @db.Decimal(12, 2)
  estimatedProfit Decimal?    @db.Decimal(12, 2)
  estimatedMargin Decimal?    @db.Decimal(8, 2)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([marketplace])
}

model CommercialTransaction {
  id         String @id @default(uuid())
  supplierId String

  quoteReference String?
  orderReference String?

  quoteDate          DateTime?
  orderEffectiveDate DateTime?

  status CommercialTransactionStatus @default(DRAFT)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier      Supplier                             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  documents     SupplierDocument[]
  purchases     Purchase[]
  statusHistory CommercialTransactionStatusHistory[]
  items         CommercialTransactionItem[]

  @@index([supplierId])
  @@index([status])
  @@index([quoteDate])
  @@index([orderEffectiveDate])
}

model SupplierDocument {
  id            String  @id @default(uuid())
  supplierId    String
  transactionId String?

  type           SupplierDocumentType
  title          String
  documentNumber String?

  originalName String
  fileName     String
  filePath     String
  fileUrl      String?
  fileSize     Int?
  mimeType     String?

  documentDate DateTime?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier    Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  transaction CommercialTransaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([transactionId])
  @@index([type])
  @@index([documentNumber])
}

model CommercialTransactionStatusHistory {
  id            String @id @default(uuid())
  transactionId String

  oldStatus CommercialTransactionStatus?
  newStatus CommercialTransactionStatus
  notes     String?

  createdAt DateTime @default(now())

  transaction CommercialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model QuoteList {
  id     String          @id @default(cuid())
  name   String
  notes  String?
  status QuoteListStatus @default(DRAFT)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  items QuoteListItem[]

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
}

model QuoteListItem {
  id String @id @default(cuid())

  quoteListId String
  quoteList   QuoteList @relation(fields: [quoteListId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Cópia dos dados no momento em que o produto entrou na lista
  productName      String
  productCode      String? @map("referenceCode")
  productReference String?

  createdAt DateTime @default(now())

  @@unique([quoteListId, productId])
  @@index([quoteListId])
  @@index([productId])
}

enum PurchaseSource {
  MANUAL
  XML
}

model Purchase {
  id            String         @id @default(uuid())
  supplierId    String
  invoiceNumber String?
  invoiceKey    String?        @unique
  purchaseDate  DateTime?
  freightTotal  Decimal        @default(0) @db.Decimal(12, 2)
  notes         String?
  source        PurchaseSource @default(MANUAL)
  transactionId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  supplier    Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  transaction CommercialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  items       PurchaseItem[]

  @@index([supplierId])
  @@index([purchaseDate])
  @@index([transactionId])
  @@index([invoiceNumber])
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  productId  String?
  position   Int      @default(0)
  name       String
  code       String?
  quantity   Decimal  @db.Decimal(14, 3)
  unitPrice  Decimal  @db.Decimal(16, 6)
  imageUrl   String?
  createdAt  DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([productId])
}

model CommercialTransactionItem {
  id            String                @id @default(uuid())
  transactionId String
  transaction   CommercialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  name          String
  code          String?
  quantity      Int
  unitPrice     Decimal               @db.Decimal(12, 2)
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([transactionId])
}

model FiscalCertificate {
  id                String    @id @default(uuid())
  cnpj              String    @unique
  companyName       String?
  ufCode            Int
  environment       Int       @default(1)
  pfxEncrypted      String    @db.Text
  passwordEncrypted String    @db.Text
  validFrom         DateTime
  validTo           DateTime
  autoCiencia       Boolean   @default(false)
  autoSync          Boolean   @default(true)
  lastNsu           String    @default("000000000000000")
  maxNsu            String?
  blockedUntil      DateTime?
  lastSyncAt        DateTime?
  lastSyncStatus    String?
  lastSyncMessage   String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  invoices ReceivedInvoice[]
}

model ReceivedInvoice {
  id              String            @id @default(uuid())
  certificateId   String
  certificate     FiscalCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  accessKey       String            @unique
  nsu             String
  issuerCnpj      String
  issuerName      String
  number          String?
  series          String?
  issuedAt        DateTime?
  totalValue      Decimal           @db.Decimal(14, 2)
  hasFullXml      Boolean           @default(false)
  xmlContent      String?           @db.Text
  cancelled       Boolean           @default(false)
  manifestStatus  String            @default("NONE")
  manifestMessage String?
  supplierId      String?
  supplier        Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([issuerCnpj])
  @@index([supplierId])
  @@index([issuedAt])
}

enum CnpjImportStatus {
  RUNNING
  PUBLISHED
  SUPERSEDED
  FAILED
}

model CnpjImportBatch {
  id                         String           @id @default(uuid())
  competence                 String
  states                     String[]
  status                     CnpjImportStatus @default(RUNNING)
  source                     String           @default("RECEITA_FEDERAL")
  activeCandidatesCount      Int              @default(0)
  companiesCount             Int              @default(0)
  establishmentsCount        Int              @default(0)
  meiExcludedCount           Int              @default(0)
  skippedMissingCompanyCount Int              @default(0)
  errorMessage               String?          @db.Text
  startedAt                  DateTime         @default(now())
  finishedAt                 DateTime?

  companies      CnpjCompany[]

  @@index([status, finishedAt])
  @@index([competence])
}

model CnpjCompany {
  cnpjBase                    String @db.VarChar(8)
  batchId                     String
  corporateName               String @db.VarChar(255)
  legalNatureCode             String? @db.VarChar(4)
  responsibleQualificationCode String? @db.VarChar(2)
  capitalSocial               Decimal? @db.Decimal(20, 2)
  companySizeCode             String? @db.VarChar(2)
  federalEntity               String? @db.VarChar(100)

  batch          CnpjImportBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  establishments CnpjEstablishment[]

  @@id([cnpjBase, batchId])
  @@index([batchId, corporateName])
  @@index([batchId, companySizeCode])
  @@index([corporateName(ops: raw("gin_trgm_ops"))], type: Gin, map: "CnpjCompany_corporateName_trgm_idx")
}

model CnpjEstablishment {
  cnpj                   String   @db.VarChar(14)
  batchId                String
  cnpjBase               String   @db.VarChar(8)
  cnpjOrder              String   @db.VarChar(4)
  cnpjDv                 String   @db.VarChar(2)
  establishmentType      String?  @db.VarChar(1)
  fantasyName            String?  @db.VarChar(255)
  registrationStatus     String   @db.VarChar(2)
  registrationStatusDate String?  @db.VarChar(8)
  registrationReasonCode String?  @db.VarChar(2)
  foreignCityName        String?
  countryCode            String?
  activityStartDate      String?  @db.VarChar(8)
  mainCnaeCode           String   @db.VarChar(7)
  secondaryCnaeCodes     String[] @default([])
  streetType             String?
  streetName             String?
  streetNumber           String?
  addressComplement      String?
  neighborhood           String?
  postalCode             String?
  uf                     String   @db.VarChar(2)
  municipalityCode       String
  ddd1                   String?
  phone1                 String?
  ddd2                   String?
  phone2                 String?
  faxDdd                 String?
  faxNumber              String?
  email                  String?
  specialStatus          String?
  specialStatusDate      String?  @db.VarChar(8)
  createdAt              DateTime @default(now())

  company     CnpjCompany           @relation(fields: [cnpjBase, batchId], references: [cnpjBase, batchId], onDelete: Cascade)
  mainCnae    CnaeReference         @relation(fields: [mainCnaeCode], references: [code], onDelete: Restrict)
  municipality MunicipalityReference @relation(fields: [municipalityCode], references: [code], onDelete: Restrict)

  @@id([cnpj, batchId])
  @@index([cnpj])
  @@index([batchId, uf, municipalityCode])
  @@index([batchId, mainCnaeCode])
  @@index([secondaryCnaeCodes], type: Gin)
  @@index([fantasyName(ops: raw("gin_trgm_ops"))], type: Gin, map: "CnpjEstablishment_fantasyName_trgm_idx")
  @@index([batchId, fantasyName])
  @@index([batchId, cnpjBase])
}

model CnaeReference {
  code        String @id @db.VarChar(7)
  description String @db.VarChar(255)

  establishments CnpjEstablishment[]
}

model MunicipalityReference {
  code String @id
  name String @db.VarChar(255)

  establishments CnpjEstablishment[]
}

model CnpjGeoCache {
  cnpj               String   @id @db.VarChar(14)
  latitude           Float
  longitude          Float
  addressFingerprint String   @db.Text
  provider           String   @default("NOMINATIM")
  geocodedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([geocodedAt])
}

